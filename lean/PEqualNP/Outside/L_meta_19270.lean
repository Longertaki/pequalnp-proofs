import PEqualNP.Library.LRAT.Checker
import PEqualNP.Defs
import Std.Sat.CNF.Dimacs
import Std.Tactic.BVDecide.LRAT.Checker
import Std.Tactic.BVDecide.LRAT.Parser

import PEqualNP.Defs
import Std.Sat.CNF.Dimacs
import Std.Tactic.BVDecide.LRAT.Checker
import Std.Tactic.BVDecide.LRAT.Parser


namespace Sound55

open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity PEqualNP.Represents

abbrev Row := Fin 4 × Fin 4

def target (r : Row) : Bool := (55 : ℕ).testBit (4 * r.1.val + r.2.val)

def inputs (r : Row) : List Bool := oneEach r.1 r.2

def opValue (op : ℕ) (a b : Bool) : Bool :=
  if op = 0 then a && b else if op = 1 then a || b else !a

def clip (n k : ℕ) : ℕ := min n k

theorem readClip (w : List Bool) (n k : ℕ) (hn : w.length = n) :
    w.getD (clip n k) false = w.getD k false := by
  unfold clip
  by_cases hk : k ≤ n
  · rw [min_eq_right hk]
  · rw [min_eq_left (by omega), List.getD_eq_default w false (n := n) (by omega),
        List.getD_eq_default w false (n := k) (by omega)]

theorem sortedOp (op : ℕ) (n i j : ℕ) (w : List Bool) (hw : w.length = n)
    (ho : op = 0 ∨ op = 1) :
    opValue op (w.getD (min (clip n i) (clip n j)) false)
        (w.getD (max (clip n i) (clip n j)) false) =
      opValue op (w.getD i false) (w.getD j false) := by
  by_cases h : clip n i ≤ clip n j
  · simp only [min_eq_left h, max_eq_right h, readClip w n _ hw]
  · have h' : clip n j ≤ clip n i := by omega
    rcases ho with rfl | rfl <;>
      simp [-List.getD_eq_getElem?_getD, min_eq_right h', max_eq_left h', readClip w n _ hw, opValue,
        Bool.and_comm, Bool.or_comm]

theorem gateNormal (n : ℕ) (g : Gate) (allowed : g.op = .and ∨ g.op = .or ∨ g.op = .not)
    (arity : g.inputs.length ≤ 2) :
    ∃ op a b : ℕ, op < 3 ∧ a ≤ b ∧ b ≤ n ∧ (op = 2 → a = b) ∧
      ∀ w : List Bool, w.length = n →
        g.op.eval (g.inputs.map fun i => w.getD i false) =
          opValue op (w.getD a false) (w.getD b false) := by
  have cl (k : ℕ) : clip n k ≤ n := Nat.min_le_left ..
  obtain ⟨op, ins⟩ := g
  rcases allowed with h | h | h
  · cases h
    cases ins with
    | nil =>
      refine ⟨2, n, n, by decide, le_rfl, le_rfl, fun _ => rfl, ?_⟩
      intro w hw
      simp [-List.getD_eq_getElem?_getD, GateOp.eval, opValue, List.getD_eq_default w false (n := n) (by omega)]
    | cons i is =>
      cases is with
      | nil =>
        refine ⟨0, clip n i, clip n i, by decide, le_rfl, cl i, by simp, ?_⟩
        intro w hw
        simp [-List.getD_eq_getElem?_getD, GateOp.eval, opValue, readClip w n _ hw]
      | cons j js =>
        cases js with
        | nil =>
          refine ⟨0, min (clip n i) (clip n j), max (clip n i) (clip n j), by decide,
            by omega, max_le (cl i) (cl j), by simp, ?_⟩
          intro w hw
          simpa [GateOp.eval, opValue] using (sortedOp 0 n i j w hw (Or.inl rfl)).symm
        | cons k ks => simp at arity
  · cases h
    cases ins with
    | nil =>
      refine ⟨1, n, n, by decide, le_rfl, le_rfl, by simp, ?_⟩
      intro w hw
      simp [-List.getD_eq_getElem?_getD, GateOp.eval, opValue, List.getD_eq_default w false (n := n) (by omega)]
    | cons i is =>
      cases is with
      | nil =>
        refine ⟨1, clip n i, clip n i, by decide, le_rfl, cl i, by simp, ?_⟩
        intro w hw
        simp [-List.getD_eq_getElem?_getD, GateOp.eval, opValue, readClip w n _ hw]
      | cons j js =>
        cases js with
        | nil =>
          refine ⟨1, min (clip n i) (clip n j), max (clip n i) (clip n j), by decide,
            by omega, max_le (cl i) (cl j), by simp, ?_⟩
          intro w hw
          simpa [GateOp.eval, opValue] using (sortedOp 1 n i j w hw (Or.inr rfl)).symm
        | cons k ks => simp at arity
  · cases h
    let i := ins.headD n
    refine ⟨2, clip n i, clip n i, by decide, le_rfl, cl i, fun _ => rfl, ?_⟩
    intro w hw
    rw [readClip w n _ hw]
    cases ins with
    | nil =>
      simp [-List.getD_eq_getElem?_getD, GateOp.eval, opValue, i, List.getD_eq_default w false (n := n) (by omega)]
    | cons j js => simp [-List.getD_eq_getElem?_getD, GateOp.eval, opValue, i]

theorem inputs_length (r : Row) : (inputs r).length = 8 := by simp [inputs, oneEach]

theorem nonconstant : (∃ r : Row, target r = true) ∧ ∃ r : Row, target r = false := by
  decide +kernel

abbrev Triple := ℕ × ℕ × ℕ

def gateOf (t : Triple) : Gate :=
  if t.1 = 0 then ⟨.and, [t.2.1, t.2.2]⟩ else
    if t.1 = 1 then ⟨.or, [t.2.1, t.2.2]⟩ else ⟨.not, [t.2.1]⟩

def step (w : List Bool) (g : Gate) : List Bool :=
  w ++ [g.op.eval (g.inputs.map fun i => w.getD i false)]

def runTape (gs : List Gate) (w : List Bool) : List Bool := gs.foldl step w

def inBounds (n : ℕ) (t : Triple) : Prop :=
  t.1 < 3 ∧ t.2.1 ≤ t.2.2 ∧ t.2.2 ≤ n ∧ (t.1 = 2 → t.2.1 = t.2.2)

theorem stepOf (w : List Bool) (t : Triple) :
    step w (gateOf t) =
      w ++ [opValue t.1 (w.getD t.2.1 false) (w.getD t.2.2 false)] := by
  unfold step gateOf opValue
  split <;> rename_i h
  · simp [GateOp.eval]
  · split <;> simp [GateOp.eval]

theorem lengthRun (gs : List Gate) (w : List Bool) :
    (runTape gs w).length = w.length + gs.length := by
  induction gs generalizing w with
  | nil => simp [runTape]
  | cons g gs ih =>
    change (runTape gs (step w g)).length = _
    rw [ih]
    simp [step]
    omega

theorem prefixRun (gs : List Gate) (w : List Bool) (i : ℕ) (hi : i < w.length) :
    (runTape gs w).getD i false = w.getD i false := by
  induction gs generalizing w with
  | nil => rfl
  | cons g gs ih =>
    change (runTape gs (step w g)).getD i false = _
    rw [ih (step w g) (by simp [step]; omega)]
    exact List.getD_append _ _ _ _ hi

theorem normalizeTape (gs : List Gate) (n : ℕ)
    (h : ∀ g ∈ gs, (g.op = .and ∨ g.op = .or ∨ g.op = .not) ∧ g.inputs.length ≤ 2) :
    ∃ ts : List Triple, ts.length = gs.length ∧
      (∀ j (hj : j < ts.length), inBounds (n + j) ts[j]) ∧
      ∀ w : List Bool, w.length = n → runTape gs w = runTape (ts.map gateOf) w := by
  induction gs generalizing n with
  | nil => exact ⟨[], rfl, (by simp), (by simp)⟩
  | cons g gs ih =>
    have gh := h g (by simp)
    obtain ⟨t, a, b, ht, ha, hb, hn, hw⟩ := gateNormal n g gh.1 gh.2
    obtain ⟨ts, hlen, hts, agrees⟩ := ih (n + 1) (fun u hu => h u (List.mem_cons_of_mem _ hu))
    refine ⟨(t, a, b) :: ts, by simp [hlen], ?_, ?_⟩
    · intro j hj
      cases j with
      | zero => exact ⟨ht, ha, hb, hn⟩
      | succ j =>
        have hj' : j < ts.length := by simpa using hj
        have hb' := hts j hj'
        simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using hb'
    · intro w nW
      change runTape gs (step w g) = runTape (ts.map gateOf) (step w (gateOf (t, a, b)))
      have eqq : step w (gateOf (t, a, b)) = step w g := by
        rw [stepOf, step, hw w nW]
      rw [eqq]
      exact agrees _ (by simp [step, nW])

def row (r : ℕ) : Row := (Fin.ofNat 4 (r / 4), Fin.ofNat 4 (r % 4))

def inputBit (r k : ℕ) : Bool :=
  if k < 4 then decide (r / 4 = k) else decide (r % 4 = k - 4)

def tableBit (r : ℕ) : Bool := (55 : ℕ).testBit r

theorem raw_agrees :
    ∀ r : Fin 16, ∀ k : Fin 8, (inputs (row r.val)).getD k.val false = inputBit r.val k.val := by
  decide +kernel

theorem target_agrees : ∀ r : Fin 16, target (row r.val) = tableBit r.val := by
  decide +kernel

structure Model where
  gates : ℕ → Triple
  output : ℕ
  value : ℕ → ℕ → Bool

def Model.read (M : Model) (j r k : ℕ) : Bool :=
  if k < 8 then inputBit r k else if k < 8 + j then M.value (k - 8) r else false

structure Correct (M : Model) : Prop where
  bounds : ∀ j < 4, inBounds (8 + j) (M.gates j)
  outBound : M.output < 8 + 4
  evalGate : ∀ j < 4, ∀ r < 16, M.value j r =
    opValue (M.gates j).1 (M.read j r (M.gates j).2.1) (M.read j r (M.gates j).2.2)
  evalOut : ∀ r < 16, M.read 4 r M.output = tableBit r

def wires (ts : List Triple) (r : ℕ) : List Bool :=
  runTape (ts.map gateOf) (inputs (row r))

theorem wiresLen (ts : List Triple) (r : ℕ) : (wires ts r).length = 8 + ts.length := by
  simp [wires, lengthRun, inputs_length]

theorem run_append (p q : List Gate) (w : List Bool) :
    runTape (p ++ q) w = runTape q (runTape p w) := by rw [runTape, List.foldl_append]; rfl

theorem wiresPreserve (ts : List Triple) (r j k : ℕ)
    (h : k < (wires (ts.take j) r).length) :
    (wires ts r).getD k false = (wires (ts.take j) r).getD k false := by
  unfold wires
  rw (occs := .pos [1]) [← List.take_append_drop j ts]
  rw [List.map_append, run_append]
  exact prefixRun _ _ _ h

theorem wiresSnoc (ts : List Triple) (t : Triple) (r : ℕ) :
    wires (ts ++ [t]) r = step (wires ts r) (gateOf t) := by
  simp [wires, List.map_append, run_append]
  rfl

theorem modelComplete (C : Circuit) (fan : FanInTwo C) (sz : C.size ≤ 4)
    (h : Represents (fun u v : Fin 4 => (55 : ℕ).testBit (4 * u.val + v.val)) C) :
    ∃ M, Correct M := by
  let padded := C.gates ++ List.replicate (4-C.size) (⟨.or, []⟩ : Gate)
  have plen : padded.length = 4 := by
    simp [padded, Circuit.size] at sz ⊢
    omega
  have basis (g : Gate) (hg : g ∈ padded) :
      (g.op = .and ∨ g.op = .or ∨ g.op = .not) ∧ g.inputs.length ≤ 2 := by
    rcases List.mem_append.mp hg with hc | hd
    · simpa only [Set.mem_insert_iff, Set.mem_singleton_iff] using fan g hc
    · have eq := (List.mem_replicate.mp hd).2
      simp [eq]
  obtain ⟨ts, len, bound, agrees⟩ := normalizeTape padded 8 basis
  have lenK : ts.length = 4 := len.trans plen
  let M : Model := ⟨fun j => ts.getD j (1, 0, 0), C.output,
    fun j r => (wires ts r).getD (8 + j) false⟩
  have ht (r : Row) : C.eval (inputs r) = target r := h r.1 r.2
  have out : C.output < 8 + C.gates.length := by
    by_contra! ho
    obtain ⟨r, hr⟩ := nonconstant.1
    have hlen : (C.wires (inputs r)).length = 8 + C.gates.length := by
      change (runTape _ _).length = _
      rw [lengthRun, inputs_length]
    have hf : C.eval (inputs r) = false :=
      List.getD_eq_default _ false (by omega)
    rw [ht r, hr] at hf
    cases hf
  have rep (r : Row) :
      (runTape (ts.map gateOf) (inputs r)).getD C.output false = target r := by
    rw [← agrees _ (inputs_length r)]
    change (runTape (C.gates ++ _) (inputs r)).getD C.output false = _
    rw [run_append, prefixRun _ _ _ (by rw [lengthRun, inputs_length]; exact out)]
    exact ht r
  have rbound (j : ℕ) (hj : j < 4) : inBounds (8 + j) (M.gates j) := by
    have hlen : j < ts.length := by rwa [lenK]
    dsimp only [M]
    rw [List.getD_eq_getElem _ _ hlen]
    exact bound j hlen
  have reads (j r k : ℕ) (hj : j ≤ 4) (hr : r < 16) :
      M.read j r k = (wires (ts.take j) r).getD k false := by
    have hlen : (wires (ts.take j) r).length = 8 + j := by simp [wiresLen, lenK, min_eq_left hj]
    unfold Model.read
    by_cases k8 : k < 8
    · rw [ite_eq_left k8]
      exact (raw_agrees ⟨r, hr⟩ ⟨k, k8⟩).symm.trans
        (prefixRun _ _ _ (by rw [inputs_length]; exact k8)).symm
    · rw [ite_eq_right k8]
      by_cases hk : k < 8 + j
      · rw [ite_eq_left hk]
        change (wires ts r).getD (8 + (k-8)) false = _
        rw [show 8 + (k-8) = k by omega]
        exact wiresPreserve _ _ _ _ (by omega)
      · rw [ite_eq_right hk, List.getD_eq_default _ false (by omega)]
  refine ⟨M, ⟨rbound, (by change C.output < 8 + 4; simp [Circuit.size] at sz; omega), ?_, ?_⟩⟩
  · intro j hj r hr
    have hlen : j < ts.length := by rwa [lenK]
    let t := ts[j]
    have take : ts.take (j+1) = ts.take j ++ [t] := List.take_succ_eq_append_getElem hlen
    have plen' : (wires (ts.take j) r).length = 8 + j := by
      simp [wiresLen, lenK, min_eq_left (Nat.le_of_lt hj)]
    change (wires ts r).getD (8 + j) false = _
    have same := wiresPreserve ts r (j + 1) (8+j)
      (by simp [wiresLen, lenK, min_eq_left (show j+1 ≤ 4 by omega)])
    rw [same, take, wiresSnoc, stepOf, ← plen', List.getD_append_right _ _ _ _ (by simp)]
    simp only [Nat.sub_self, List.getD_cons_zero]
    rw [reads j r _ (by omega) hr, reads j r _ (by omega) hr]
    dsimp only [M]
    rw [List.getD_eq_getElem _ _ hlen]
  · intro r hr
    rw [reads 4 r _ le_rfl hr, ← lenK, List.take_length]
    exact (rep (row r)).trans (target_agrees ⟨r, hr⟩)


abbrev Lit := Nat × Bool
abbrev Clauses := List (List Lit)

def code (t j k : ℕ) : ℕ := 128*t+16*j+k
def p (t j k : ℕ) : Lit := (code t j k, true)
def q (t j k : ℕ) : Lit := (code t j k, false)
def l (t j k : ℕ) (b : Bool) : Lit := (code t j k, b)

def exactly (t j m : ℕ) : Clauses :=
  [(List.range m).map (p t j)] ++ (List.range m).flatMap fun a =>
    (List.range' (a+1) (m-a-1)).map fun b => [q t j a, q t j b]

def sources (t j r k : ℕ) : Clauses :=
  if k < 8 then [[q t j k, l (3+t) j r (inputBit r k)]]
  else if k < 8+j then
    [[q t j k, q (3+t) j r, p 3 (k-8) r], [q t j k, p (3+t) j r, q 3 (k-8) r]]
  else [[q t j k, q (3+t) j r]]

def ordered (j a b : ℕ) : Clauses :=
  (if b < a then [[q 1 j a, q 2 j b]] else []) ++
  (if a ≠ b then [[q 0 j 2, q 1 j a, q 2 j b]] else [])

def gatesCNF (j r : ℕ) : Clauses :=
  [[q 0 j 0, q 4 j r, q 5 j r, p 3 j r],
   [q 0 j 0, p 4 j r, q 3 j r], [q 0 j 0, p 5 j r, q 3 j r],
   [q 0 j 1, p 4 j r, p 5 j r, q 3 j r],
   [q 0 j 1, q 4 j r, p 3 j r], [q 0 j 1, q 5 j r, p 3 j r],
   [q 0 j 2, q 3 j r, q 4 j r], [q 0 j 2, p 3 j r, p 4 j r]]
def outputCNF (r k : ℕ) : Clauses :=
  if k < 8 then if inputBit r k = tableBit r then [] else [[q 6 0 k]]
  else if k < 8 + 4 then [[q 6 0 k, l 3 (k-8) r (tableBit r)]]
  else if tableBit r then [[q 6 0 k]] else []

def formula : Clauses :=
  ((List.range 4).flatMap fun j =>
    exactly 0 j 3 ++
    ([1,2].flatMap fun t => exactly t j (9+j) ++
      (List.range 16).flatMap fun r => (List.range (9+j)).flatMap fun k => sources t j r k) ++
    ((List.range (9+j)).flatMap fun a => (List.range (9+j)).flatMap fun b => ordered j a b) ++
    ((List.range 16).flatMap fun r => gatesCNF j r)) ++
  exactly 6 0 16 ++
  ((List.range 16).flatMap fun r => (List.range 16).flatMap fun k => outputCNF r k)

def packed (M : Model) (t j k : ℕ) : Bool :=
  match t with
  | 0 => decide ((M.gates j).1 = k)
  | 1 => decide ((M.gates j).2.1 = k)
  | 2 => decide ((M.gates j).2.2 = k)
  | 3 => M.value j k
  | 4 => M.read j k (M.gates j).2.1
  | 5 => M.read j k (M.gates j).2.2
  | 6 => decide (M.output = k)
  | _ => false

def assign (M : Model) (v : ℕ) : Bool := packed M (v/128) ((v/16)%8) (v%16)

theorem pack_read (M : Model) (t j k : ℕ) (hj : j < 8) (hk : k < 16) :
    assign M (code t j k) = packed M t j k := by
  unfold assign code
  rw [show (128*t+16*j+k)/128 = t by omega,
    show (128*t+16*j+k)/16%8 = j by omega, show (128*t+16*j+k)%16 = k by omega]

def TrueClause (a : ℕ → Bool) (c : List Lit) : Prop := ∃ s ∈ c, a s.1 = s.2
def TrueCNF (a : ℕ → Bool) (f : Clauses) : Prop := ∀ c ∈ f, TrueClause a c

@[simp] theorem clauseEmpty (a : ℕ → Bool) : ¬ TrueClause a [] := by simp [TrueClause]

@[simp] theorem clauseCons (a : ℕ → Bool) (x : Lit) (xs : List Lit) :
    TrueClause a (x :: xs) ↔ a x.1 = x.2 ∨ TrueClause a xs := by
  constructor
  · rintro ⟨u, hu, hv⟩
    rcases List.mem_cons.mp hu with rfl | hm
    · exact Or.inl hv
    · exact Or.inr ⟨u, hm, hv⟩
  · rintro (hx | ⟨u, hu, hv⟩)
    · exact ⟨x, by simp, hx⟩
    · exact ⟨u, List.mem_cons_of_mem _ hu, hv⟩
theorem joinTrue {a : ℕ → Bool} {f g : Clauses} :
    TrueCNF a (f ++ g) ↔ TrueCNF a f ∧ TrueCNF a g := by
  simp only [TrueCNF, List.mem_append]
  constructor
  · intro h; exact ⟨fun c hc => h c (Or.inl hc), fun c hc => h c (Or.inr hc)⟩
  · intro h c hc; exact hc.elim (h.1 c) (h.2 c)

theorem eachTrue {α : Type} {a : ℕ → Bool} {xs : List α} {f : α → Clauses} :
    TrueCNF a (xs.flatMap f) ↔ ∀ x ∈ xs, TrueCNF a (f x) := by
  simp only [TrueCNF, List.mem_flatMap]
  constructor
  · intro h x hx c hc
    exact h c ⟨x,hx,hc⟩
  · intro h c hc
    obtain ⟨x,hx,hc⟩ := hc
    exact h x hx c hc

theorem mapTrue {α : Type} {a : ℕ → Bool} {xs : List α} {f : α → List Lit} :
    TrueCNF a (xs.map f) ↔ ∀ x ∈ xs, TrueClause a (f x) := by
  simp only [TrueCNF, List.mem_map]
  constructor
  · intro h x hx
    exact h (f x) ⟨x,hx,rfl⟩
  · intro h c hc
    obtain ⟨x,hx,rfl⟩ := hc
    exact h x hx

theorem exactlyTrue (M : Model) (t j m o : ℕ) (hj : j<8) (hm : m≤16) (ho : o<m)
    (hpack : ∀ k, packed M t j k = decide (o=k)) : TrueCNF (assign M) (exactly t j m) := by
  unfold exactly
  rw [joinTrue,eachTrue]
  constructor
  · intro c hc
    have eq : c = (List.range m).map (p t j) := by simpa using hc
    subst c
    exact ⟨p t j o, List.mem_map.mpr ⟨o, List.mem_range.mpr ho, rfl⟩, by simp [p, pack_read M t j o hj (by omega), hpack]⟩
  · intro a ha
    rw [List.mem_range] at ha
    rw [mapTrue]
    intro b hb
    rw [List.mem_range'] at hb
    have ab : a < b := by omega
    have hb' : b < 16 := by omega
    simp [q, pack_read M t j a hj (by omega), pack_read M t j b hj hb', hpack]
    omega

theorem sourceTrue (M : Model) (t j r k : ℕ) (ht : t = 1 ∨ t = 2)
    (hj : j < 4) (hr : r < 16) (hk : k < 9+j) :
    TrueCNF (assign M) (sources t j r k) := by
  have kk : k < 16 := by omega
  have kg : k - 8 < 8 := by omega
  have js : j < 8 := by omega
  rcases ht with rfl | rfl
  · by_cases h : (M.gates j).2.1 = k
    · unfold sources
      split <;> try split
      all_goals simp [TrueCNF, p, q, l, pack_read M _ _ _ js kk,
        pack_read M _ _ _ js hr, pack_read M _ _ _ kg hr, packed,
        Model.read, h, *]
    · unfold sources
      split <;> try split
      all_goals simp [TrueCNF, p, q, l, pack_read M _ _ _ js kk, packed, h]
  · by_cases h : (M.gates j).2.2 = k
    · unfold sources
      split <;> try split
      all_goals simp [TrueCNF, p, q, l, pack_read M _ _ _ js kk,
        pack_read M _ _ _ js hr, pack_read M _ _ _ kg hr, packed,
        Model.read, h, *]
    · unfold sources
      split <;> try split
      all_goals simp [TrueCNF, p, q, l, pack_read M _ _ _ js kk, packed, h]

theorem orderTrue (M : Model) (hm : Correct M) (j a b : ℕ)
    (hj : j < 4) (ha : a < 9+j) (hb : b < 9+j) :
    TrueCNF (assign M) (ordered j a b) := by
  have j8 : j < 8 := by omega
  have a16 : a < 16 := by omega
  have b16 : b < 16 := by omega
  have t16 : 2 < 16 := by decide
  obtain ⟨_, ok, _, notSame⟩ := hm.bounds j hj
  unfold ordered
  rw [joinTrue]
  constructor
  · split
    · rename_i bad
      simp [TrueCNF, q, pack_read M _ _ _ j8 a16, pack_read M _ _ _ j8 b16, packed]
      omega
    · simp [TrueCNF]
  · split
    · rename_i ne
      simp [TrueCNF, q, pack_read M _ _ _ j8 a16, pack_read M _ _ _ j8 b16,
        pack_read M _ _ _ j8 t16, packed]
      by_cases h : (M.gates j).1 = 2
      · have eq := notSame h
        omega
      · simp [h]
    · simp [TrueCNF]

theorem opTrue (M : Model) (hm : Correct M) (j r : ℕ) (hj : j < 4) (hr : r < 16) :
    TrueCNF (assign M) (gatesCNF j r) := by
  have j8 : j < 8 := by omega
  have k0 : 0 < 16 := by decide
  have k1 : 1 < 16 := by decide
  have k2 : 2 < 16 := by decide
  have lt := (hm.bounds j hj).1
  have eq : (M.gates j).1 = 0 ∨ (M.gates j).1 = 1 ∨ (M.gates j).1 = 2 := by omega
  rcases eq with op | op | op <;>
    cases a : M.read j r (M.gates j).2.1 <;>
    cases b : M.read j r (M.gates j).2.2 <;>
    simp [TrueCNF, gatesCNF, p, q, pack_read M _ _ _ j8 hr,
      pack_read M _ _ _ j8 k0, pack_read M _ _ _ j8 k1,
      pack_read M _ _ _ j8 k2, packed, op,
      hm.evalGate j hj r hr, a, b, opValue]


theorem outTrue (M : Model) (hm : Correct M) (r k : ℕ) (hr : r < 16) (hk : k < 16) :
    TrueCNF (assign M) (outputCNF r k) := by
  have z8 : 0 < 8 := by decide
  have k8 : k-8 < 8 := by omega
  have correct := hm.evalOut r hr
  by_cases h : M.output = k
  · rw [h] at correct
    unfold Model.read at correct
    unfold outputCNF
    split
    · rename_i small
      simp [small] at correct
      simp [correct, TrueCNF]
    · have mid : k < 8 + 4 := h ▸ hm.outBound
      simp [mid, TrueCNF, q, l, pack_read M _ _ _ z8 hk,
        pack_read M _ _ _ k8 hr, packed, h, *] at *
      exact correct
  · unfold outputCNF
    split <;> split <;>
      simp [TrueCNF, q, l, pack_read M _ _ _ z8 hk, packed, h]

theorem formulaTrue (M : Model) (hm : Correct M) : TrueCNF (assign M) formula := by
  unfold formula
  repeat rw [joinTrue]
  refine ⟨⟨?_, ?_⟩, ?_⟩
  · rw [eachTrue]
    intro j hj
    rw [List.mem_range] at hj
    have j8 : j < 8 := by omega
    obtain ⟨t3, ab, bnd, hn⟩ := hm.bounds j hj
    repeat rw [joinTrue]
    refine ⟨⟨⟨?_, ?_⟩, ?_⟩, ?_⟩
    · exact exactlyTrue M 0 j 3 (M.gates j).1 j8 (by decide) t3 (by intros; rfl)
    · rw [eachTrue]
      intro t ht
      simp at ht
      rw [joinTrue,eachTrue]
      constructor
      · rcases ht with rfl | rfl
        · exact exactlyTrue M 1 j (9+j) (M.gates j).2.1 j8 (by omega) (by omega) (by intros; rfl)
        · exact exactlyTrue M 2 j (9+j) (M.gates j).2.2 j8 (by omega) (by omega) (by intros; rfl)
      · intro r hr
        rw [eachTrue]
        intro k hk
        exact sourceTrue M t j r k ht hj (List.mem_range.mp hr) (List.mem_range.mp hk)
    · rw [eachTrue]
      intro a ha
      rw [eachTrue]
      intro b hb
      exact orderTrue M hm j a b hj (List.mem_range.mp ha) (List.mem_range.mp hb)
    · rw [eachTrue]
      intro r hr
      exact opTrue M hm j r hj (List.mem_range.mp hr)
  · exact exactlyTrue M 6 0 16 M.output (by decide) le_rfl (by have := hm.outBound; omega) (by intros; rfl)
  · rw [eachTrue]
    intro r hr
    rw [eachTrue]
    intro k hk
    exact outTrue M hm r k (List.mem_range.mp hr) (List.mem_range.mp hk)




open Std.Sat in
def cnf : Std.Sat.CNF Nat := ⟨formula.toArray.map Std.Sat.CNF.Clause.ofLiterals⟩

theorem satisfiesCNF (a : ℕ → Bool) (h : TrueCNF a formula) : cnf.eval a = true := by
  rw [Std.Sat.CNF.eval, Array.all_eq_true']
  intro c hc
  change c ∈ formula.toArray.map Std.Sat.CNF.Clause.ofLiterals at hc
  obtain ⟨ls, hls, rfl⟩ := Array.mem_map.mp hc
  obtain ⟨t, ht, he⟩ := h ls (by simpa using hls)
  rw [Std.Sat.CNF.Clause.eval, Std.Sat.CNF.Clause.literals_ofLiterals, List.any_eq_true]
  exact ⟨t, ht, by cases t; simp_all⟩

end Sound55

open Std.Tactic.BVDecide.LRAT
open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity PEqualNP.Represents

theorem Sound55.noCircuitOfUnsat (hu : Sound55.cnf.Unsat) :
    ¬ (∃ C : Circuit, FanInTwo C ∧ C.size ≤ 4 ∧
      Represents (fun u v : Fin 4 => (55 : ℕ).testBit (4 * u.val + v.val)) C) := by
  rintro ⟨C, fan, sz, correct⟩
  obtain ⟨M, h⟩ := Sound55.modelComplete C fan sz correct
  have hc := Sound55.satisfiesCNF (Sound55.assign M) (Sound55.formulaTrue M h)
  rw [hu (Sound55.assign M)] at hc
  cases hc

theorem Sound55.noCircuitOfCertificate (cert : Array IntAction) (h : check cert Sound55.cnf) :
    ¬ (∃ C : Circuit, FanInTwo C ∧ C.size ≤ 4 ∧
      Represents (fun u v : Fin 4 => (55 : ℕ).testBit (4 * u.val + v.val)) C) :=
  Sound55.noCircuitOfUnsat (check_sound cert Sound55.cnf h)

def main (args : List String) : IO UInt32 := do
  match args with
  | ["emit", dest] =>
    IO.FS.writeFile dest (Std.Sat.CNF.dimacs Sound55.cnf)
    IO.println "emitted"
    return 0
  | ["check", path] =>
    let certificate ← Std.Tactic.BVDecide.LRAT.loadLRATProof path
    if Std.Tactic.BVDecide.LRAT.check certificate Sound55.cnf then
      IO.println "VERIFIED UNSAT for the sound Lean encoding"
      return 0
    IO.eprintln "Certificate rejected"
    return 1
  | _ =>
    IO.eprintln "Usage: emit out.cnf | check cert.lrat"
    return 2


