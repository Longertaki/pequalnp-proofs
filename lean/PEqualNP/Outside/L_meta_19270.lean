namespace S55

open PEqualNP.Library.LRAT

theorem clauseSat_encode {a : Nat → Bool} {c : List Sound55.Lit}
    (h : Sound55.TrueClause a c) :
    ClauseSat (fun n => if n = 0 then false else a (n - 1))
      (c.map fun (v, b) => if b then 2 * (v + 1) else 2 * (v + 1) + 1) := by
  rcases h with ⟨l, hl, hval⟩
  obtain ⟨v, b⟩ := l
  refine ⟨if b then 2 * (v + 1) else 2 * (v + 1) + 1, ?_, ?_⟩
  · exact List.mem_map.mpr ⟨(v, b), hl, rfl⟩
  · cases b
    · have h1 : (2 * (v + 1) + 1) / 2 = v + 1 := by omega
      have h2 : (2 * (v + 1) + 1) % 2 = 1 := by omega
      have h3 : v + 1 ≠ 0 := by omega
      simp [litVal, h1, h2, h3, hval]
    · have h1 : (2 * (v + 1)) / 2 = v + 1 := by omega
      have h2 : (2 * (v + 1)) % 2 = 0 := by omega
      have h3 : v + 1 ≠ 0 := by omega
      simp [litVal, h1, h2, h3, hval]

theorem formulaSat_of_trueCNF (a : Nat → Bool) (h : Sound55.TrueCNF a Sound55.formula) :
    FormulaSat F := by
  refine ⟨fun n => if n = 0 then false else a (n - 1), ?_⟩
  intro c hc
  rcases List.mem_map.mp hc with ⟨d, hd, rfl⟩
  exact clauseSat_encode (h d hd)

open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity PEqualNP.Represents

theorem noBar : ¬ (∃ C : Circuit, FanInTwo C ∧ C.size ≤ 4 ∧
    Represents (fun u v : Fin 4 => (55 : ℕ).testBit (4 * u.val + v.val)) C) := by
  rintro ⟨C, fan, sz, hrep⟩
  obtain ⟨M, hM⟩ := Sound55.modelComplete C fan sz hrep
  exact unsat (formulaSat_of_trueCNF (Sound55.assign M) (Sound55.formulaTrue M hM))


end S55


theorem PEqualNP.Outside.L_meta_19270 :
    ¬ (∃ C : PEqualNP.CircuitLowerBounds.Circuit,
        PEqualNP.MetaComplexity.FanInTwo C ∧ C.size ≤ 4 ∧
        PEqualNP.Represents.Represents
          (fun u v : Fin 4 => (55 : ℕ).testBit (4 * u.val + v.val)) C) :=
  S55.noBar
