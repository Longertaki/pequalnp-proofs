    ⟨PEqualNP.CircuitLowerBounds.GateOp.not, [3, 0]⟩,
    ⟨PEqualNP.CircuitLowerBounds.GateOp.not, [1, 7]⟩,
    ⟨PEqualNP.CircuitLowerBounds.GateOp.or, [4, 3]⟩,
    ⟨PEqualNP.CircuitLowerBounds.GateOp.or, [3, 6]⟩,
    ⟨PEqualNP.CircuitLowerBounds.GateOp.or, [0, 1]⟩,
    ⟨PEqualNP.CircuitLowerBounds.GateOp.or, [9, 5]⟩,
    ⟨PEqualNP.CircuitLowerBounds.GateOp.not, [12, 8]⟩,
    ⟨PEqualNP.CircuitLowerBounds.GateOp.or, [11, 13]⟩,
    ⟨PEqualNP.CircuitLowerBounds.GateOp.and, [10, 14]⟩], 15⟩, ?_, by decide, by decide⟩
  intro g hg
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hg
